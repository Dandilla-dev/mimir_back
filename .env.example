# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не должен попадать в git!

ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL. Для локальной разработки — контейнер из docker-compose.yml
# (docker compose up -d db), логин/пароль/база: mimir/mimir/mimir.
DATABASE_URL=postgresql://mimir:mimir@localhost:5432/mimir
# Необязательно: размер пула соединений и интервал фонового стирания
# содержимого отклонённых сообщений (секунды).
# DATABASE_POOL_SIZE=10
# PURGE_INTERVAL_SECONDS=3600

# Нужны только если voice.provider = elevenlabs в config.yaml
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
