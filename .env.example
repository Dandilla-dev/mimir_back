# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не должен попадать в git!

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# true — не ходить в Claude API, отвечать заглушками (без ключа включается само).
MOCK_CLAUDE=false

# --- База данных ---
# Для локальной разработки — контейнер из docker-compose.yml
# (docker compose up -d db), логин/пароль/база: mimir/mimir/mimir.
DATABASE_URL=postgresql://mimir:mimir@localhost:5432/mimir
# Отдельная база для автотестов (pytest её очищает!). Создаётся один раз:
#   docker compose exec db createdb -U mimir mimir_test
TEST_DATABASE_URL=postgresql://mimir:mimir@localhost:5432/mimir_test
# Необязательно:
# DATABASE_POOL_SIZE=10
# PURGE_INTERVAL_SECONDS=3600   # уборка: отклонённые сообщения, просроченные сессии
# SESSION_LIFETIME_DAYS=30

# --- Сервер ---
# Адреса фронтенда, которым браузер разрешит обращаться к API (через запятую).
# По умолчанию — Vite dev-сервер (http://localhost:5173).
# CORS_ORIGINS=http://localhost:5173,https://mimir.example.com
# Локальная нейросеть: true только при установленном requirements-ml.txt.
LOAD_LOCAL_MODEL=false

# --- Голос (не используется API) ---
# Нужны только если voice.provider = elevenlabs в config.yaml
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
